# Client-side Vite environment variables (safe to expose in browser requests)
# Base URL of your Supabase project (e.g., https://your-project-ref.supabase.co)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Public Supabase anonymous key sent in the Authorization: Bearer header
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Server-only secret (DO NOT prefix with VITE_ or bundle into the frontend)
# Set via Supabase CLI: `supabase secrets set GEMINI_API_KEY="your-gemini-api-key"`
GEMINI_API_KEY="MY_GEMINI_API_KEY"
